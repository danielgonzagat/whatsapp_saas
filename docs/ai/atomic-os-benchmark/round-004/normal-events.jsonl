22.0\",\n    \"ts-node\": \"10.9.2\",\n    \"typescript\": \"5.9.3\",\n    \"typescript-eslint\": \"8.59.3\",\n    \"vitest\": \"4.1.6\"\n  }\n}\n","exit_code":0,"status":"completed"}}
