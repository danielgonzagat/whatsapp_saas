= true || record.executed === true;\n692:   }\n693: \n694:   private num(v: unknown, fb = 0): number {\n695:     const n = Number(v);\n696:     return Number.isFinite(n) ? Math.round(n) : fb;\n697:   }\n698: \n699:   private async buildAgentRuntimeContext(params: {\n700:     workspaceId: string;\n701:     channel: string;\n702:     message: string;\n703:     contactId?: string;\n704:     allowedTools?: string[];\n705:   }): Promise<{ systemPromptBlock: string }> {\n706:     if (!this.agentRuntime) {\n707:       return { systemPromptBlock: '' };\n708:     }\n709:     return this.agentRuntime.buildContext(params);\n710:   }\n711: \n712:   private async recordAgentRuntimeTurn(params: {\n713:     workspaceId: string;\n714:     channel: string;\n715:     userMessage: string;\n716:     assistantMessage?: string;\n717:     contactId?: string;\n718:     intent?: string;\n719:     confidence?: number;\n720:     actions?: Array<{ toolName: string; success: boolean; result?: unknown }>;\n721:   }): Promise<void> {\n722:     await this.agentRuntime?.recordTurnOutcome(params);\n723:   }\n724: \n725:   private buildAgentToolEnvelope(params: {\n726:     workspaceId: string;\n727:     toolName: string;\n728:   }): { id: string; toolName: string; allowed: boolean } {\n729:     return (\n730:       this.agentRuntime?.buildToolEnvelope(params) ?? {\n731:         id: 'agent-runtime-unavailable',\n732:         toolName: params.toolName,\n733:         allowed: true,\n734:       }\n735:     );\n736:   }\n737: }\n\n(End of file - total 737 lines)\n</content>","metadata":{"preview":"import { Injectable, Optional } from '@nestjs/common';\nimport { ConfigService } from '@nestjs/config';\nimport { StructuredLogger } from '../logging/structured-logger';\nimport OpenAI from 'openai';\nimport type { ChatCompletionMessageParam } from 'openai/resources/chat';\nimport { PlanLimitsService } from '../billing/plan-limits.service';\nimport { AuditService } from '../audit/audit.service';\nimport { create