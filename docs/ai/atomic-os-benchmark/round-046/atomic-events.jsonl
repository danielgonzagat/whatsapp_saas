{"type":"tool_use","timestamp":1778985493507,"sessionID":"ses_1cc344e4bffeVGC3fAbZWWX03N","part":{"type":"tool","tool":"read","callID":"call_03_o0IfaUvcgX6bvMvcBFuW5003","state":{"status":"completed","input":{"filePath":"/private/tmp/kloel-ab046-atomic-20260516233536/backend/src/kloel/unified-agent.service.ts"},"output":"<path>/private/tmp/kloel-ab046-atomic-20260516233536/backend/src/kloel/unified-agent.service.ts</path>\n<type>file</type>\n<content>\n1: import { Injectable, Optional } from '@nestjs/common';\n2: import { ConfigService } from '@nestjs/config';\n3: import { StructuredLogger } from '../logging/structured-logger';\n4: import OpenAI from 'openai';\n5: import type { ChatCompletionMessageParam } from 'openai/resources/chat';\n6: import { PlanLimitsService } from '../billing/plan-limits.service';\n7: import { AuditService } from '../audit/audit.service';\n8: import { createTextLlmClient } from '../lib/llm-provider';\n9: import { resolveBackendOpenAIModel } from '../lib/openai-models';\n10: import { PrismaService } from '../prisma/prisma.service';\n11: import { chatCompletionWithFallback } from './openai-wrapper';\n12: import { forEachSequential } from '../common/async-sequence';\n13: import { UnifiedAgentContextService } from './unified-agent-context.service';\n14: import { UnifiedAgentResponseService } from './unified-agent-response.service';\n15: import { UnifiedAgentActionsService } from './unified-agent-actions.service';\n16: import { AgentRuntimeContextService } from './agent-runtime';\n17: import { AbiBuilderService } from './abi/abi-builder.service';\n18: import { validateAbiPayload } from './abi/abi-validator';\n19: import { RiskGateService } from './risk-class/risk-gate.service';\n20: export type { ToolArgs, ActionEntry } from './unified-agent.types';\n21: import type { ToolArgs, ActionEntry, PredecidedAction } from './unified-agent.types';\n22: import {\n23:   buildPredecidedActionDraft,\n24:   executePredecidedAgentActions,\n25: } from './unified-agent-predecided-actions.part';\n26: \n27: type UnknownRecord = Record<string, unknown>;\n28: \n29: function isAllowedTool(toolName: string, allowedTools?: string[]): boolean {\n30:   return !allowedTools || allowedTools.includes(toolName);\n31: }\n32: \n33: const UNIFIED_AGENT_PROVIDER_CONFIG_REQUIRED =\n34:   'Primary LLM configuration is required for unified agent generation';\n35: \n36: function formatPromptValue(value: unknown): string {\n37:   if (value === null) {\n38:     return 'null';\n39:   }\n40:   if (Array.isArray(value)) {\n41:     return `[${value.map(formatPromptValue).join(',')}]`;\n42:   }\n43:   if (typeof value === 'object') {\n44:     const record = value as Record<string, unknown>;\n45:     return `{${Object.keys(record)\n46:       .sort()\n47:       .map((key) => `${key}:${formatPromptValue(record[key])}`)\n48:       .join(',')}}`;\n49:   }\n50:   if (typeof value === 'string') {\n51:     return `\"${value.replaceAll('\\\\', '\\\\\\\\').replaceAll('\"', '\\\\\"')}\"`;\n52:   }\n53:   if (typeof value === 'number' || typeof value === 'boolean' || typeof value === 'bigint') {\n54:     return String(value);\n55:   }\n56:   if (typeof value === 'undefined') {\n57:     return 'undefined';\n58:   }\n59:   return Object.prototype.toString.call(value);\n60: }\n61: \n62: /**\n63:  * KLOEL Unified Agent Service — orchestrator.\n64:  *\n65:  * This service coordinates context loading, LLM calls, tool dispatch, and\n66:  * response composition. All heavy logic lives in the sub-services injected\n67:  * here. The constructor, processMessage, and executeToolAction router are the\n68:  * only concerns of this file.\n69:  */\n70: /** Idempotency: enforced at HTTP layer via @Idempotent() guard + Stripe idempotencyKey. */\n71: @Injectable()\n72: export class UnifiedAgentService {\n73:   private readonly logger = StructuredLogger.from(UnifiedAgentService.name);\n74:   private readonly openai: OpenAI | null;\n75:   private readonly primaryBrainModel: string;\n76:   private readonly fallbackBrainModel: string;\n77:   private readonly writerModel: string;\n78:   private readonly fallbackWriterModel: string;\n79: \n80:   constructor(\n81:     private readonly prisma: PrismaService,\n82:     private readonly config: ConfigService,\n83:     private readonly planLimits: PlanLimitsService,\n84:     private readonly auditService: AuditService,\n85:     private readonly ctx: UnifiedAgentContextService,\n86:     private readonly response: UnifiedAgentResponseService,\n87:     private readonly actions: UnifiedAgentActionsService,\n88:     @Optional() private readonly agentRuntime?: AgentRuntimeContextService,\n89:     @Optional() private readonly abiBuilder?: AbiBuilderService,\n90:     @Optional() private readonly riskGate?: RiskGateService,\n91:   ) {\n92:     this.openai = createTextLlmClient(this.config);\n93:     this.primaryBrainModel = resolveBackendOpenAIModel('brain', this.config);\n94:     this.fallbackBrainModel = resolveBackendOpenAIModel('brain_fallback', this.config);\n95:     this.writerModel = resolveBackendOpenAIModel('writer', this.config);\n96:     this.fallbackWriterModel = resolveBackendOpenAIModel('writer_fallback', this.config);\n97:   }\n98: \n99:   async processIncomingMessage(params: {\n100:     workspaceId: string;\n101:     phone: string;\n102:     message: string;\n103:     contactId?: string;\n104:     channel?: string;\n105:     context?: UnknownRecord;\n106:     executeTools?: boolean;\n107:   }): Promise<{\n108:     reply?: string;\n109:     response?: string;\n110:     actions: ActionEntry[];\n111:     intent: string;\n112:     confidence: number;\n113:   }> {\n114:     const result = await this.processMessage({\n115:       workspaceId: params.workspaceId,\n116:       contactId: params.contactId || '',\n117:       phone: params.phone,\n118:       message: params.message,\n119:       context: {\n120:         channel: params.channel || 'whatsapp',\n121:         executeTools: params.executeTools !== false,\n122:         ...(params.context || {}),\n123:       },\n124:     });\n125: \n126:     return {\n127:       actions: result.actions,\n128:       intent: result.intent,\n129:       confidence: result.confidence,\n130:       ...(result.response !== undefined\n131:         ? { reply: result.response, response: result.response }\n132:         : {}),\n133:     };\n134:   }\n135: \n136:   async processMessage(params: {\n137:     allowedTools?: string[];\n138:     predecidedActions?: PredecidedAction[];\n139:     workspaceId: string;\n140:     contactId: string;\n141:     phone: string;\n142:     message: string;\n143:     context?: UnknownRecord;\n144:   }): Promise<{\n145:     actions: ActionEntry[];\n146:     response?: string;\n147:     intent: string;\n148:     confidence: number;\n149:   }> {\n150:     const { workspaceId, contactId, phone, message, context } = params;\n151: \n152:     const predecidedActions = params.predecidedActions ?? [];\n153: \n154:     if (!this.openai && predecidedActions.length === 0) {\n155:       this.logger.warn('OpenAI not configured');\n156:       return this.response.buildFallbackResult(message);\n157:     }\n158: \n159:     // 1. Load workspace / contact / history / products in parallel\n160:     const [workspace, contact, conversationHistory, products] = await Promise.all([\n161:       this.ctx.getWorkspaceContext(workspaceId),\n162:       this.ctx.getContactContext(workspaceId, contactId, phone),\n163:       this.ctx.getConversationHistory(workspaceId, contactId, 0, phone),\n164:       this.ctx.getProducts(workspaceId),\n165:     ]);\n166: \n167:     // 1b. Load AI config per product (commercial brain)\n168:     const productIds = products\n169:       .map((product: UnknownRecord) => {\n170:         const productValue = this.ctx.readRecord(product.value);\n171:         return this.ctx.readOptionalText(productValue.id) || this.ctx.readOptionalText(product.id);\n172:       })\n173:       .filter((productId): productId is string => Boolean(productId));\n174:     let aiConfigs: UnknownRecord[] = [];\n175:     if (productIds.length > 0) {\n176:       try {\n177:         aiConfigs = await this.prisma.productAIConfig.findMany({\n178:           take: 50,\n179:           where: { productId: { in: productIds } },\n180:           select: {\n181:             id: true,\n182:             productId: true,\n183:             tone: true,\n184:             persistenceLevel: true,\n185:             messageLimit: true,\n186:             customerProfile: true,\n187:             positioning: true,\n188:             objections: true,\n189:             salesArguments: true,\n190:           },\n191:         });\n192:       } catch {\n193:         /* ProductAIConfig may not exist yet */\n194:       }\n195:     }\n196: \n197:     const compressedContext = await this.ctx.buildAndPersistCompressedContext(\n198:       workspaceId,\n199:       contactId,\n200:       phone,\n201:       contact,\n202:     );\n203:     const tacticalHint = this.ctx.buildLeadTacticalHint({\n204:       leadName: this.ctx.isRecord(contact) ? this.ctx.readText(contact.name).trim() : '',\n205:       currentMessage: message,\n206:       conversationHistory,\n207:     });\n208: \n209:     // 2. Build system prompt and style instruction\n210:     const agentRuntimeContext = await this.buildAgentRuntimeContext({\n211:       workspaceId,\n212:       channel: this.ctx.readText(context?.channel, 'whatsapp'),\n213:       message,\n214:       contactId,\n215:       ...(params.allowedTools !== undefined ? { allowedTools: params.allowedTools } : {}),\n216:     });\n217:     const systemPrompt = [\n218:       this.ctx.buildSystemPrompt(workspace, products, aiConfigs),\n219:       agentRuntimeContext.systemPromptBlock,\n220:     ].join('\\n\\n');\n221:     const stylePolicy = this.response.buildReplyStyleInstruction(\n222:       message,\n223:       conversationHistory.length,\n224:     );\n225:     const contactData: Record<string, unknown> = this.ctx.isRecord(contact) ? contact : {};\n226:     const contactName = this.ctx.readText(contactData.name).trim() || phone;\n227:     const contactSentiment = this.ctx.readText(contactData.sentiment).trim() || 'NEUTRAL';\n228:     const leadScore = this.ctx.readText(contactData.leadScore, '0');\n229:     const tagNames = this.ctx.readTagList(contactData.tags);\n230: \n231:     // 3. Build messages array\n232:     const additionalContext = context ? formatPromptValue(context) : '';\n233:     const currentInput = {\n234:       raw: message,\n235:       channel: this.ctx.readText(context?.channel, 'whatsapp'),\n236:       arrivalTimestamp: new Date().toISOString(),\n237:     };\n238:     let cognitiveState: Record<string, unknown> = {\n239:       abiStatus: this.abiBuilder ? 'unavailable_or_invalid' : 'builder_not_injected',\n240:       audience: 'public',\n241:       perceptionSnapshot: { channel: currentInput.channel },\n242:     };\n243: \n244:     if (this.abiBuilder) {\n245:       const abiResult = await this.abiBuilder.build({\n246:         audience: 'public',\n247:         currentInput,\n248:         perceptionSnapshot: {\n249:           channel: currentInput.channel,\n250:         },\n251:       });\n252: \n253:       if (abiResult.status !== 'ok') {\n254:         this.logger.warn(\n255:           `ABI build failed: ${abiResult.reason}, using structured unified agent fallback`,\n256:         );\n257:       } else {\n258:         const abi = abiResult.abi;\n259:         const validation = validateAbiPayload(abi);\n260: \n261:         if (validation.status === 'FAIL') {\n262:           this.logger.warn(\n263:             `ABI validation failed: ${JSON.stringify(validation.issues)}, using structured unified agent fallback`,\n264:           );\n265:         } else {\n266:           cognitiveState = abi as unknown as Record<string, unknown>;\n267:         }\n268:       }\n269:     }\n270: \n271:     const messages: ChatCompletionMessageParam[] = [\n272:       ...conversationHistory,\n273:       {\n274:         role: 'user',\n275:         content: JSON.stringify({\n276:           cognitiveState,\n277:           runtimeContext: {\n278:             workspaceProductContext: systemPrompt,\n279:             compressedMemory: compressedContext || null,\n280:             additionalContext,\n281:             tacticalHint:\n282:               tacticalHint || 'responder com clareza, valor concreto e próximo passo.',\n283:             responsePolicy: stylePolicy,\n284:           },\n285:           contact: {\n286:             name: contactName,\n287:             sentiment: contactSentiment,\n288:             leadScore,\n289:             tags: tagNames,\n290:           },\n291:           currentInput,\n292:         }),\n293:       },\n294:     ];\n295: \n296:     if (predecidedActions.length > 0) {\n297:       const actionsList = await executePredecidedAgentActions({\n298:         ...(params.allowedTools !== undefined ? { allowedTools: params.allowedTools } : {}),\n299:         contactId,\n300:         ...(context !== undefined ? { context } : {}),\n301:         executeTool: this.executeToolAction.bind(this),\n302:         logAutopilotEvent: this.actions.logAutopilotEvent.bind(this.actions),\n303:         phone,\n304:         predecidedActions,\n305:         workspaceId,\n306:       });\n307:       const intent = this.response.extractIntent(actionsList, message);\n308:       const draftedReply = await this.response.composeWriterReply(\n309:         this.openai,\n310:         this.writerModel,\n311:         this.fallbackWriterModel,\n312:         {\n313:           workspaceId,\n314:           customerMessage: message,\n315:           assistantDraft: buildPredecidedActionDraft(actionsList),\n316:           actions: actionsList,\n317:           historyTurns: conversationHistory.length,\n318:         },\n319:       );\n320: \n321:       await this.recordAgentRuntimeTurn({\n322:         workspaceId,\n323:         channel: this.ctx.readText(context?.channel, 'whatsapp'),\n324:         userMessage: message,\n325:         ...(draftedReply !== undefined ? { assistantMessage: draftedReply } : {}),\n326:         contactId,\n327:         intent,\n328:         confidence: actionsList.length > 0 ? 0.85 : 0.55,\n329:         actions: actionsList.map((action) => ({\n330:           toolName: action.tool,\n331:           success: this.actionSucceeded(action.result),\n332:           result: action.result,\n333:         })),\n334:       });\n335: \n336:       return {\n337:         actions: actionsList,\n338:         ...(draftedReply !== undefined ? { response: draftedReply } : {}),\n339:         intent,\n340:         confidence: actionsList.length > 0 ? 0.85 : 0.55,\n341:       };\n342:     }\n343: \n344:     // 4. Ask the LLM to verbalize only; code-native actions enter via predecidedActions.\n345:     let llmResponse: OpenAI.Chat.ChatCompletion;\n346:     try {\n347:       await this.planLimits.ensureTokenBudget(params.workspaceId);\n348:       const openai = this.openai;\n349:       if (!openai) {\n350:         const error = new Error();\n351:         error.message = UNIFIED_AGENT_PROVIDER_CONFIG_REQUIRED;\n352:         throw error;\n353:       }\n354:       llmResponse = await chatCompletionWithFallback(\n355:         openai,\n356:         {\n357:           model: this.primaryBrainModel,\n358:           messages,\n359:           temperature: 0.82,\n360:           top_p: 0.9,\n361:         },\n362:         this.fallbackBrainModel,\n363:       );\n364:     } catch (err: unknown) {\n365:       const msg = err instanceof Error ? err.message : typeof err === 'string' ? err : 'unknown';\n366:       this.logger.error(`OpenAI agent processing failed, using fallback: ${msg}`);\n367:       return this.response.buildFallbackResult(message);\n368:     }\n369:     if (!llmResponse) {\n370:       return this.response.buildFallbackResult(message);\n371:     }\n372:     const firstChoice = llmResponse.choices[0];\n373:     if (!firstChoice) {\n374:       return this.response.buildFallbackResult(message);\n375:     }\n376:     await this.planLimits\n377:       .trackAiUsage(params.workspaceId, llmResponse.usage?.total_tokens ?? 500)\n378:       .catch(() => {});\n379: \n380:     const assistantMessage = firstChoice.message;\n381:     const actionsList: ActionEntry[] = [];\n382: \n383:     // 5. Process tool calls\n384:     const executeTools = context?.executeTools !== false;\n385:     if (executeTools && assistantMessage.tool_calls && assistantMessage.tool_calls.length > 0) {\n386:       await forEachSequential(assistantMessage.tool_calls, async (toolCall) => {\n387:         if (toolCall.type !== 'function') {\n388:           return;\n389:         }\n390:         const toolName = toolCall.function.name;\n391:         if (!isAllowedTool(toolName, params.allowedTools)) {\n392:           this.logger.warn(\n393:             `Blocked disallowed agent tool call: workspaceId=${workspaceId} tool=${toolName}`,\n394:           );\n395:           const blockedResult = { blocked: true, reason: 'capability_not_allowed' };\n396:           actionsList.push({ tool: toolName, args: {}, result: blockedResult });\n397:           await this.actions.logAutopilotEvent(workspaceId, contactId, toolName, {}, blockedResult);\n398:           return;\n399:         }\n400:         let toolArgs: Record<string, unknown> = {};\n401:         try {\n402:           toolArgs = JSON.parse(toolCall.function.arguments || '{}');\n403:         } catch {\n404:           this.logger.warn(`Failed to parse tool args for ${toolName}`);\n405:         }\n406:         const result = await this.executeToolAction(\n407:           workspaceId,\n408:           contactId,\n409:           phone,\n410:           toolName,\n411:           toolArgs,\n412:           context,\n413:         );\n414:         actionsList.push({ tool: toolName, args: toolArgs, result });\n415:         await this.actions.logAutopilotEvent(workspaceId, contactId, toolName, toolArgs, result);\n416:       });\n417:     }\n418: \n419:     // 6. Extract intent, confidence, and compose final reply\n420:     const intent = this.response.extractIntent(actionsList, message);\n421:     const confidence = this.response.calculateConfidence(actionsList, llmResponse);\n422:     const draftedReply = await this.response.composeWriterReply(\n423:       this.openai,\n424:       this.writerModel,\n425:       this.fallbackWriterModel,\n426:       {\n427:         workspaceId,\n428:         customerMessage: message,\n429:         assistantDraft: assistantMessage.content,\n430:         actions: actionsList,\n431:         historyTurns: conversationHistory.length,\n432:       },\n433:     );\n434: \n435:     await this.recordAgentRuntimeTurn({\n436:       workspaceId,\n437:       channel: this.ctx.readText(context?.channel, 'whatsapp'),\n438:       userMessage: message,\n439:       ...(draftedReply !== undefined ? { assistantMessage: draftedReply } : {}),\n440:       contactId,\n441:       intent,\n442:       confidence,\n443:       actions: actionsList.map((action) => ({\n444:         toolName: action.tool,\n445:         success: this.actionSucceeded(action.result),\n446:         result: action.result,\n447:       })),\n448:     });\n449: \n450:     return {\n451:       actions: actionsList,\n452:       ...(draftedReply !== undefined ? { response: draftedReply } : {}),\n453:       intent,\n454:       confidence,\n455:     };\n456:   }\n457: \n458:   /**\n459:    * Public API: execute a single named tool directly.\n460:    */\n461:   async executeTool(\n462:     tool: string,\n463:     args: ToolArgs,\n464:     ctx: { workspaceId: string; contactId?: string; phone?: string },\n465:   ): Promise<unknown> {\n466:     return this.executeToolAction(\n467:       ctx.workspaceId,\n468:       ctx.contactId || '',\n469:       ctx.phone || '',\n470:       tool,\n471:       args,\n472:     );\n473:   }\n474: \n475:   /** Build quoted reply plan (delegates to response service).