{
  "$schema": "./node_modules/knip/schema.json",
  "include": ["files", "dependencies", "unlisted", "unresolved", "exports", "types"],
  "ignore": ["frontend-admin/**"],
  "ignoreDependencies": [
    "@playwright/test",
    "@types/node",
    "@jest/globals",
    "prettier",
    "typescript",
    "@nestjs/event-emitter",
    "@nestjs/schedule",
    "@opencode-ai/sdk",
    "lucide-react",
    "qrcode",
    "react",
    "zustand",
    "@biomejs/biome",
    "madge"
  ],
  "prisma": false,
  "ignoreWorkspaces": ["dist", "node_modules"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs}"],
      "project": ["scripts/**/*.{ts,mjs}"],
      "ignore": [
        "scripts/orchestration/**",
        "scripts/obsidian-mirror-daemon.mjs",
        "scripts/agent-orchestrator.ts"
      ],
      "ignoreDependencies": ["ts-node", "@nestjs/common", "@prisma/client"]
    },
    "backend": {
      "entry": [
        "src/main.ts",
        "src/bootstrap.ts",
        "src/instrument.ts",
        "src/**/*.module.ts",
        "src/**/*.controller.ts",
        "src/**/*.service.ts",
        "src/**/*.gateway.ts",
        "prisma/**/*.ts",
        "scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts", "prisma/**/*.ts", "scripts/**/*.ts"],
      "ignore": ["src/**/*.spec.ts", "test/**", "dist/**"],
      "ignoreDependencies": ["dotenv", "swagger-ui-express"]
    },
    "frontend": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/hooks/**/*.ts",
        "src/lib/**/*.{ts,tsx}",
        "next.config.ts",
        "instrumentation.ts",
        "instrumentation-client.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
      "ignore": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/**/*.test.tsx", ".next/**"],
      "ignoreDependencies": ["baseline-browser-mapping", "tailwindcss", "tw-animate-css"]
    },
    "worker": {
              "entry": [
        "bootstrap.ts",
        "processor.ts",
        "campaign-processor.ts",
        "flow-engine-global.ts",
        "media-processor.ts",
        "scraper-processor.ts",
        "voice-processor.ts",
        "queue.ts",
        "reprocess-dlq.ts",
        "retry-jobs.ts",
        "providers/**/*.ts",
        "processors/**/*.ts",
        "utils/**/*.ts"
      ],
      "project": ["**/*.ts"],
      "ignore": ["dist/**", "node_modules/**", "test/**"]
    },
    "e2e": {
      "entry": ["playwright.config.ts", "specs/**/*.ts"],
      "project": ["**/*.ts"]
    }
  }
}
