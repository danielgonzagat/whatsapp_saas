{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert/strict\";import{BinarySerde}from\"../serializer/binary.js\";describe(\"BinarySerde\",()=>{describe(\"serialize\",()=>{it(\"serializes a single int8 field\",()=>{const schema={fields:[{name:\"age\",type:\"int8\"}]};const serde=new BinarySerde(schema);const buf=serde.serialize({age:42});assert.equal(buf.length,1);assert.equal(buf[0],42)});it(\"serializes a single uint32 field little-endian\",()=>{const schema={fields:[{name:\"count\",type:\"uint32\"}]};const serde=new BinarySerde(schema);const buf=serde.serialize({count:3735928559});assert.equal(buf.length,4);const view=new DataView(buf.buffer);assert.equal(view.getUint32(0,true),3735928559)});it(\"serializes a boolean field as 1 byte\",()=>{const schema={fields:[{name:\"active\",type:\"bool\"}]};const serde=new BinarySerde(schema);assert.equal(serde.serialize({active:true})[0],1);assert.equal(serde.serialize({active:false})[0],0)});it(\"serializes a float64 field\",()=>{const schema={fields:[{name:\"pi\",type:\"float64\"}]};const serde=new BinarySerde(schema);const buf=serde.serialize({pi:Math.PI});assert.equal(buf.length,8);const view=new DataView(buf.buffer);assert.ok(Math.abs(view.getFloat64(0,true)-Math.PI)<1e-15)});it(\"serializes a string with uint16 length prefix\",()=>{const schema={fields:[{name:\"name\",type:\"string\"}]};const serde=new BinarySerde(schema);const buf=serde.serialize({name:\"Hello\"});const view=new DataView(buf.buffer);assert.equal(view.getUint16(0,true),5);assert.equal(buf.length,7)});it(\"serializes multiple fields in schema order\",()=>{const schema={fields:[{name:\"id\",type:\"uint32\"},{name:\"name\",type:\"string\"},{name:\"score\",type:\"float32\"}]};const serde=new BinarySerde(schema);const buf=serde.serialize({id:1,name:\"ABC\",score:9.5});const view=new DataView(buf.buffer);assert.equal(view.getUint32(0,true),1);assert.equal(view.getUint16(4,true),3)})});describe(\"deserialize\",()=>{it(\"deserializes int8\",()=>{const schema={fields:[{name:\"val\",type:\"int8\"}]};const serde=new BinarySerde(schema);assert.equal(serde.deserialize(new Uint8Array([42])).val,42)});it(\"deserializes negative int32\",()=>{const schema={fields:[{name:\"delta\",type:\"int32\"}]};const serde=new BinarySerde(schema);const buf=new Uint8Array(4);new DataView(buf.buffer).setInt32(0,-100,true);assert.equal(serde.deserialize(buf).delta,-100)})});describe(\"round-trip\",()=>{it(\"preserves complex object through serialize-deserialize\",()=>{const schema={fields:[{name:\"id\",type:\"uint32\"},{name:\"title\",type:\"string\"},{name:\"price\",type:\"float64\"},{name:\"inStock\",type:\"bool\"}]};const serde=new BinarySerde(schema);const original={id:42,title:\"Widget\",price:19.99,inStock:true};assert.deepStrictEqual(serde.deserialize(serde.serialize(original)),original)});it(\"handles uint16 array round-trip\",()=>{const schema={fields:[{name:\"tags\",type:\"uint16\",array:true}]};const serde=new BinarySerde(schema);const original={tags:[10,20,30]};assert.deepStrictEqual(serde.deserialize(serde.serialize(original)),original)});it(\"handles empty string round-trip\",()=>{const schema={fields:[{name:\"text\",type:\"string\"}]};const serde=new BinarySerde(schema);assert.equal(serde.serialize({text:\"\"}).length,2);assert.equal(serde.deserialize(serde.serialize({text:\"\"})).text,\"\")});it(\"handles zero values correctly\",()=>{const schema={fields:[{name:\"a\",type:\"int8\"},{name:\"b\",type:\"uint32\"},{name:\"c\",type:\"float64\"}]};const serde=new BinarySerde(schema);const original={a:0,b:0,c:0};assert.deepStrictEqual(serde.deserialize(serde.serialize(original)),original)})});describe(\"getSchema\",()=>{it(\"returns the constructor schema\",()=>{const schema={fields:[{name:\"x\",type:\"int32\"}]};assert.deepStrictEqual(new BinarySerde(schema).getSchema(),schema)})})});describe(\"nullable fields\",()=>{it(\"serializes a nullable string as null (0x00) when undefined\",()=>{const schema={fields:[{name:\"opt\",type:\"string\",nullable:true}]};const serde=new BinarySerde(schema);const buf=serde.serialize({opt:null});assert.equal(buf.length,3);assert.equal(buf[0],0);assert.equal(buf[1],0);assert.equal(buf[2],0)});it(\"serializes a nullable int32 with 0x01 flag when present\",()=>{const schema={fields:[{name:\"val\",type:\"int32\",nullable:true}]};const serde=new BinarySerde(schema);const buf=serde.serialize({val:42});assert.equal(buf.length,5);assert.equal(buf[0],1)});it(\"round-trips nullable and non-nullable in same schema\",()=>{const schema={fields:[{name:\"id\",type:\"uint32\"},{name:\"email\",type:\"string\",nullable:true},{name:\"name\",type:\"string\"}]};const serde=new BinarySerde(schema);const original={id:1,email:null,name:\"Test\"};const result=serde.deserialize(serde.serialize(original));assert.deepStrictEqual(result,original)});it(\"handles nullable int32 array\",()=>{const schema={fields:[{name:\"scores\",type:\"int32\",nullable:true,array:true}]};const serde=new BinarySerde(schema);const original={scores:[10,null,30]};const result=serde.deserialize(serde.serialize(original));assert.deepStrictEqual(result,original)})});\n","warnings":[],"map":{"version":3,"mappings":"AAAA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,qBACnB,OAAS,gBAAmB,0BAG5B,SAAS,cAAe,IAAM,CAC5B,SAAS,YAAa,IAAM,CAC1B,GAAG,iCAAkC,IAAM,CACzC,MAAM,OAAiB,CAAE,OAAQ,CAAC,CAAE,KAAM,MAAO,KAAM,MAAO,CAAC,CAAE,EACjE,MAAM,MAAQ,IAAI,YAA6B,MAAM,EACrD,MAAM,IAAM,MAAM,UAAU,CAAE,IAAK,EAAG,CAAC,EACvC,OAAO,MAAM,IAAI,OAAQ,CAAC,EAC1B,OAAO,MAAM,IAAI,CAAC,EAAG,EAAE,CACzB,CAAC,EAED,GAAG,iDAAkD,IAAM,CACzD,MAAM,OAAiB,CAAE,OAAQ,CAAC,CAAE,KAAM,QAAS,KAAM,QAAS,CAAC,CAAE,EACrE,MAAM,MAAQ,IAAI,YAA+B,MAAM,EACvD,MAAM,IAAM,MAAM,UAAU,CAAE,MAAO,UAAW,CAAC,EACjD,OAAO,MAAM,IAAI,OAAQ,CAAC,EAC1B,MAAM,KAAO,IAAI,SAAS,IAAI,MAAM,EACpC,OAAO,MAAM,KAAK,UAAU,EAAG,IAAI,EAAG,UAAU,CAClD,CAAC,EAED,GAAG,uCAAwC,IAAM,CAC/C,MAAM,OAAiB,CAAE,OAAQ,CAAC,CAAE,KAAM,SAAU,KAAM,MAAO,CAAC,CAAE,EACpE,MAAM,MAAQ,IAAI,YAAiC,MAAM,EACzD,OAAO,MAAM,MAAM,UAAU,CAAE,OAAQ,IAAK,