#!/usr/bin/env sh
npm run format:check

# L11 multi-agent TaskGraph claim check.
# When AGENT_NAME is set, derive cluster IDs from staged files and validate
# against active task-graph locks. STRICT BY DEFAULT — collisions FAIL the
# commit. Override:
#   AGENT_NAME=         # unset, bypass entirely
#   TASK_GRAPH_BYPASS=1 # explicit emergency-bypass (audit-logged)
#   TASK_GRAPH_STRICT=0 # warn-only (collisions logged but commit proceeds)
# Audit log: graphify-out/hooks.log
if [ -n "$AGENT_NAME" ] && [ -f tools/hooks/pre-commit-claim-check.mjs ]; then
  : "${TASK_GRAPH_STRICT:=1}"  # strict by default
  export TASK_GRAPH_STRICT
  node tools/hooks/pre-commit-claim-check.mjs || exit $?
fi
